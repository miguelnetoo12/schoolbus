rules_version = '2';
// =====================================================================
// SchoolBus – Regras de segurança do Firestore
// Cole este conteúdo em: Firebase Console → Firestore Database → Regras
// → Publicar.
//
// Níveis (definidos na coleção "usuarios", pela tela Acesso e privacidade):
//   admin     → cadastra e edita tudo
//   operador  → motorista: vê alunos, marca embarque, informa atrasos
//   público   → qualquer visitante (responsáveis): vê rotas, ônibus,
//               escolas, avisos e consulta 1 aluno pelo código
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function papel() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel
        : 'publico';
    }
    function admin() { return papel() == 'admin'; }
    function equipe() { return papel() == 'admin' || papel() == 'operador'; }

    // Informações públicas (mapa, horários, avisos)
    match /rotas/{id}   { allow read: if true; allow write: if admin(); }
    match /escolas/{id} { allow read: if true; allow write: if admin(); }
    match /onibus/{id}  { allow read: if true; allow write: if admin(); }
    match /config/{id}  { allow read: if true; allow write: if admin(); }
    match /avisos/{id}  { allow read: if true; allow create, update: if equipe(); allow delete: if admin(); }
    match /status/{id}  { allow read: if true; allow write: if equipe(); }

    // Consulta do responsável: lê UM aluno pelo código, mas não lista todos
    match /consulta/{codigo} {
      allow get: if true;
      allow list: if admin();
      allow write: if admin();
    }

    // Dados pessoais: só a equipe
    match /alunos/{id}     { allow read: if equipe(); allow write: if admin(); }
    match /motoristas/{id} { allow read: if equipe(); allow write: if admin(); }
    match /presencas/{id}  { allow read, write: if equipe(); }

    // Níveis de acesso: cada um lê o próprio; só o admin altera
    match /usuarios/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin());
      allow list, write: if admin();
    }
  }
}
